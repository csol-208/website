{
  "name": "website",
  "version": "1.0.0",
  "description": "This repository contains the course website for **AI-Augmented Data Science for Climate Leadership** at UC Berkeley.",
  "main": "index.js",
  "scripts": {
    "build:css": "sass assets/scss/material-kit.scss assets/css/material-kit.css",
    "watch:css": "sass --watch assets/scss/material-kit.scss assets/css/material-kit.css",
    "build:html": "eleventy",
    "serve": "eleventy --serve",
    "build": "npm run build:css && npm run build:html",
    "start": "npm run build && npm run serve",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csol-208/website.git"
  },
